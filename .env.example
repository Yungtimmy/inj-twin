# Supabase project URL (server and metadata only; the browser never talks to Supabase).
NEXT_PUBLIC_SUPABASE_URL=

# Service role key. Server only. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. When unset, searches use fixtures/ and the UI shows a Demo data badge.
X_BEARER_TOKEN=

# Optional. Share links and the host printed on the card. Defaults to https://injtwin.vercel.app.
NEXT_PUBLIC_SITE_URL=https://injtwin.vercel.app

# Postgres URL for the concurrency test. The test drops and recreates the public schema.
# Point this at an empty database, never production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/injtwin_test
